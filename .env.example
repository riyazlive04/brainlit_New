# -----------------------------------------------------------------------------
# BrainLIT — environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.
# -----------------------------------------------------------------------------

# Canonical site origin. Used for metadataBase, sitemap and OG image URLs.
# Must be the real https origin in production or OG previews break.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# --- Supabase ----------------------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security completely.
# Never prefix with NEXT_PUBLIC_. Never import outside lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact -----------------------------------------------------------------
# International format, digits only, no "+". e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analytics (M5) ----------------------------------------------------------
# All tags load through GTM and stay gated behind cookie consent.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Email (M3) --------------------------------------------------------------
# Requires SPF and DKIM configured on brainlit.in before sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Chatbot -----------------------------------------------------------------
# Evolution GO - outbound WhatsApp for the chatbot. Self-hosted alongside this
# repo at ../evolution_GO. Its docker-compose maps host 4001 -> container 4000,
# so the local base URL is http://localhost:4001 with NO path suffix. (Upstream
# defaults to 8080; this deployment does not.)
#
# EVOLUTION_API_KEY is the INSTANCE TOKEN, not the global admin key. Evolution
# GO resolves which WhatsApp session to send from by looking the token up
# (GetInstanceByToken), which is why there is no instance-name setting - the
# token already picks the instance. Create one with POST /instance/create and
# pair it by scanning GET /instance/{name}/qrcode.
#
# Both are required together; with either missing, numbers are still captured
# and the send is recorded as `not_configured` rather than lost.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
