# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and must be committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by scripts/preview-shape.ts
shape-preview.*

# local build artefacts
og.png

# Lighthouse reports
lh*.json

.vercel

# Raw model exports. The optimised meshopt versions in public/ are what ship;
# these are the 40MB+ originals straight out of Tripo3D and must not be cloned.
/*.glb

# Client asset drops. Whatever arrives from Drive or WhatsApp is a SOURCE, not
# a deliverable — the cropped and compressed versions under public/ are what
# ship. A 28MB zip in here is 28MB in every clone, forever, even after deletion.
/drive-download-*.zip
/*.zip
/OIP*.webp

# Patches produced while working. Reproducing them means re-running the work,
# not replaying a file that has drifted from the branch it was cut against.
/*.patch
